# Set by `npx convex dev` (written to .env.local, which is git-ignored)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Server secrets live in Convex env vars (`npx convex env set …`), never here:
#   SITE_URL, JWT_PRIVATE_KEY, JWKS            (Convex Auth, set by `npx @convex-dev/auth`)
#   INTAKE_KEY_SHOP, INTAKE_KEY_DABUS          (M2)
#   NABOOPAY_WEBHOOK_SECRET, NABOOPAY_API_KEY  (M5, key scope `read`)
#   NABOOPAY_BASE_URL=https://api.naboopay.com/api/v2
