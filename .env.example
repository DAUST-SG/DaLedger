# Set by `npx convex dev` (written to .env.local, which is git-ignored)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Server secrets live in Convex env vars (`npx convex env set …`), never here:
#   SITE_URL, JWT_PRIVATE_KEY, JWKS            (Convex Auth, set by `npx @convex-dev/auth`)
#   INTAKE_SOURCES=shop,dabus                  (M2)
#   INTAKE_KEY_SHOP, INTAKE_KEY_DABUS          (M2, one per source, ≥ 16 chars)
#
# Local only, for `npm run mock:intake` (put in .env.local):
#   MOCK_INTAKE_KEY=<the dev INTAKE_KEY_SHOP>
#   NABOOPAY_WEBHOOK_SECRET                    (M5, from the dashboard's webhook settings)
#   NABOOPAY_API_KEY                           (M5, scope `read` ONLY)
#   NABOOPAY_SG_WALLETS=wave:+221…,om:+221…    (M5, the SG's own payout wallets)
#   NABOOPAY_BASE_URL=https://api.naboopay.com/api/v2
