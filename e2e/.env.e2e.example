# Copy to e2e/.env.e2e (git-ignored) and fill in. Credentials stay in this file,
# never on the command line or in shell history.

# The deployment to test (defaults to the dev Vercel URL if unset).
E2E_BASE_URL=https://daledger-dev.vercel.app

# An officer login on that deployment. Use a throwaway test officer; rotate after.
E2E_OFFICER_EMAIL=
E2E_OFFICER_PASSWORD=
